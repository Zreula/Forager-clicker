		},
		{
			"uuid": "26cd5563-0cee-4108-8057-1a038cbca942",
			"title": "Phase 1 — Le clic",
			"description": "Objectif jouable : on clique et les chiffres montent.\nProfondeur (progression, ne baisse jamais) et minerai (monnaie) sont deux valeurs séparées.",
			"category": "4378b63c-f5dc-4fc6-86db-5ffb1384fc42",
			"steps": [
				{
					"details": "Autoload Game : profondeur, minerai + signaux depth_changed / ore_changed",
					"done": true
				},
				{
					"details": "Scène Main : bouton Creuser + labels profondeur et minerai",
					"done": true
				},
				{
					"details": "Un clic donne +X m et +minerai ; l'interface se met à jour via les signaux",
					"done": true
				},
				{
					"details": "Formatage des nombres : m / km, et 1,2 K / 3,4 M",
					"done": false
				}
			]
		},
		{
			"uuid": "c2a43012-ca70-4c15-aafb-f680fa30da5a",
			"title": "Phase 2 — Générateurs",
			"description": "Objectif jouable : le jeu avance tout seul.\nCoût d'un générateur = coût_base × 1.15^possédés",
			"category": "348d6167-626b-49d3-a302-ec5fd07701a9",
			"steps": [
				{
					"details": "Resource GeneratorData (nom, coût de base, m/s, couche requise)",
					"done": false
				},
				{
					"details": "3 premiers générateurs en .tres (Pelle, Pioche, Marteau-piqueur)",
					"done": false
				},
				{
					"details": "Scène réutilisable GeneratorRow, instanciée par code",
					"done": false
				},
				{
					"details": "Achat avec coût exponentiel ; bouton grisé si pas assez de minerai",
					"done": false
				},
				{
					"details": "Production dans _process(delta) + affichage des m/s",
					"done": false
				}
			]
		},
		{
			"uuid": "2f0eda94-96ed-49fa-81e9-a70a697afe69",
			"title": "Phase 3 — Couches",
			"description": "Objectif jouable : on descend et le décor change.\nTerre 0 m · Roche 100 m · Croûte profonde 5 km · Manteau supérieur 35 km · Manteau inférieur 660 km · Noyau externe 2 900 km · Noyau interne 5 150 km · Centre 6 371 km",
			"category": "348d6167-626b-49d3-a302-ec5fd07701a9",
			"steps": [
				{
					"details": "Resource LayerData (nom, profondeur de début, couleur, dureté, minerai par mètre)",
					"done": false
				},
				{
					"details": "Les 7 couches en .tres",
					"done": false
				},
				{
					"details": "Détection de la couche courante + signal layer_changed",
					"done": false
				},
				{
					"details": "Couleur de fond + nom de la couche affichés",
					"done": false
				},
				{
					"details": "Barre de progression vers le centre",
					"done": false
				},
				{
					"details": "Générateurs débloqués selon la couche ; ajouter les 4 derniers",
					"done": false
				},
				{
					"details": "Raccourcis de debug (F1 : +minerai, F2 : vitesse ×10), seulement si OS.is_debug_build()",
					"done": false
				}
			]
		},
		{
			"uuid": "17477696-05c6-414a-b20d-4b28a6dcfa94",
			"title": "Phase 4 — Améliorations",
			"description": "La production est calculée à un seul endroit : Game.get_production().",
			"category": "348d6167-626b-49d3-a302-ec5fd07701a9",
			"steps": [
				{
					"details": "Resource UpgradeData (nom, coût, type d'effet, cible, valeur, condition d'apparition)",
					"done": false
				},
				{
					"details": "Section Améliorations : n'afficher que celles débloquées et non achetées",
					"done": false
				},
				{
					"details": "Effets : ×2 sur un générateur, bonus de clic",
					"done": false
				},
				{
					"details": "10 à 12 améliorations (1 par générateur + 3 ou 4 pour le clic)",
					"done": false
				}
